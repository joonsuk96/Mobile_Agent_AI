# Copy this file to .env and enter your own API key.
# Never commit .env. Keep this template free of real credentials.
OPENAI_API_KEY=
JARVIS_MODEL=gpt-6-luna

# Optional: full path to your local adb executable.
# JARVIS_ADB_PATH=C:/Android/platform-tools/adb.exe

# Optional: required only when choosing among multiple connected devices.
# JARVIS_DEVICE_SERIAL=

# Optional execution limits. Defaults depend on the action limit.
# JARVIS_MAX_ACTIONS=100
# JARVIS_MAX_MODEL_CALLS=200
# JARVIS_MAX_TOOL_CALLS=400
# JARVIS_MAX_REPLANS=10
# JARVIS_MAX_RECOVERIES=5
# JARVIS_TIMING=1
